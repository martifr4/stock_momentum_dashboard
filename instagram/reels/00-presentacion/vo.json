{"duration": 45.6, "lines": [
 {"t": 0.0, "text": "Daniel Kahneman, Nobel de Economía,"},
 {"t": 1.833, "text": "explicó que decides con dos sistemas."},
 {"t": 3.933, "text": "Sistema 1: rápido e impulsivo."},
 {"t": 6.2, "text": "Sistema 2: lento y reflexivo."},
 {"t": 8.567, "text": "Pausa será el 2. Chispa, el 1."},
 {"t": 10.967, "text": "Esta es Chispa."},
 {"t": 12.033, "text": "Rápida, impulsiva, decide sin preguntar."},
 {"t": 14.367, "text": "¡Ya, ya, ya!"},
 {"t": 15.7, "text": "Y esta es Pausa."},
 {"t": 16.867, "text": "Tranquila. Hace las cuentas"},
 {"t": 18.433, "text": "cuando llega."},
 {"t": 19.333, "text": "Espera, déjame pensarlo."},
 {"t": 20.833, "text": "Ojo: Chispa no es la mala."},
 {"t": 22.633, "text": "Sin ella, tardarías media hora"},
 {"t": 24.467, "text": "en cruzar la calle."},
 {"t": 25.633, "text": "El problema: Chispa decide primero."},
 {"t": 27.933, "text": "Pausa llega tarde."},
 {"t": 29.4, "text": "Y cuando llega, Chispa ya ha pagado."},
 {"t": 31.267, "text": "Ofertas flash. Cuentas atrás. Quedan dos."},
 {"t": 34.033, "text": "Todo está diseñado para hablar con Chispa"},
 {"t": 36.267, "text": "antes de que Pausa se entere."},
 {"t": 38.067, "text": "Todos tenemos una Chispa y una Pausa."},
 {"t": 40.167, "text": "Aquí enseñamos a Pausa a llegar a tiempo."},
 {"t": 42.167, "text": "¿Quién manda en tu cabeza?"},
 {"t": 43.4, "text": "Comenta rojo o azul."}
]}
