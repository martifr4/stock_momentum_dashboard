{"duration": 37.8, "lines": [
 {"t": 0.0, "text": "En tu cabeza viven dos."},
 {"t": 1.433, "text": "Y una acaba de gastarse tu dinero."},
 {"t": 3.167, "text": "Esta es Chispa."},
 {"t": 4.233, "text": "Rápida, impulsiva, decide sin preguntar."},
 {"t": 6.567, "text": "¡Ya, ya, ya!"},
 {"t": 7.9, "text": "Y esta es Pausa."},
 {"t": 9.067, "text": "Tranquila. Hace las cuentas"},
 {"t": 10.633, "text": "cuando llega."},
 {"t": 11.533, "text": "Espera, déjame pensarlo."},
 {"t": 13.033, "text": "Ojo: Chispa no es la mala."},
 {"t": 14.833, "text": "Sin ella, tardarías media hora"},
 {"t": 16.667, "text": "en cruzar la calle."},
 {"t": 17.833, "text": "El problema: Chispa decide primero."},
 {"t": 20.133, "text": "Pausa llega tarde."},
 {"t": 21.6, "text": "Y cuando llega, Chispa ya ha pagado."},
 {"t": 23.467, "text": "Ofertas flash. Cuentas atrás. Quedan dos."},
 {"t": 26.233, "text": "Todo está diseñado para hablar con Chispa"},
 {"t": 28.467, "text": "antes de que Pausa se entere."},
 {"t": 30.267, "text": "Todos tenemos una Chispa y una Pausa."},
 {"t": 32.367, "text": "Aquí enseñamos a Pausa a llegar a tiempo."},
 {"t": 34.367, "text": "¿Quién manda en tu cabeza?"},
 {"t": 35.6, "text": "Comenta rojo o azul."}
]}
