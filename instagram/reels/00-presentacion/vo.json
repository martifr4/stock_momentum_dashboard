{"duration": 53.933, "lines": [
 {"t": 0.00,  "text": "En tu cabeza viven dos."},
 {"t": 1.70,  "text": "Y una acaba de gastarse tu dinero."},
 {"t": 5.20,  "text": "Esta es Chispa."},
 {"t": 6.40,  "text": "Rápida, impulsiva, decide sin preguntar."},
 {"t": 8.40,  "text": "¡Ya, ya, ya!"},
 {"t": 11.53, "text": "Y esta es Pausa."},
 {"t": 13.60, "text": "Tranquila. Hace las cuentas"},
 {"t": 15.20, "text": "cuando llega."},
 {"t": 16.07, "text": "Espera, déjame pensarlo."},
 {"t": 17.73, "text": "Ojo: Chispa no es la mala."},
 {"t": 21.07, "text": "Sin ella, tardarías media hora"},
 {"t": 22.53, "text": "en cruzar la calle."},
 {"t": 23.93, "text": "El problema: Chispa decide primero."},
 {"t": 26.27, "text": "Pausa llega tarde."},
 {"t": 29.93, "text": "Y cuando llega, Chispa ya ha pagado."},
 {"t": 32.93, "text": "Ofertas flash. Cuentas atrás. Quedan dos."},
 {"t": 35.60, "text": "Todo está diseñado para hablar con Chispa"},
 {"t": 38.27, "text": "antes de que Pausa se entere."},
 {"t": 42.27, "text": "Todos tenemos una Chispa y una Pausa."},
 {"t": 44.93, "text": "Aquí enseñamos a Pausa a llegar a tiempo."},
 {"t": 48.93, "text": "¿Quién manda en tu cabeza?"},
 {"t": 50.93, "text": "Comenta rojo o azul."}
]}
