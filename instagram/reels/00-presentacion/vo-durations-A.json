[
 {
  "t": 0.0,
  "text": "En tu cabeza viven dos.",
  "dur": 1.25
 },
 {
  "t": 1.7,
  "text": "Y una acaba de gastarse tu dinero.",
  "dur": 1.56
 },
 {
  "t": 5.2,
  "text": "Esta es Chispa.",
  "dur": 0.88
 },
 {
  "t": 6.4,
  "text": "Rápida, impulsiva, decide sin preguntar.",
  "dur": 2.17
 },
 {
  "t": 8.4,
  "text": "¡Ya, ya, ya!",
  "dur": 0.89
 },
 {
  "t": 11.53,
  "text": "Y esta es Pausa.",
  "dur": 0.97
 },
 {
  "t": 13.6,
  "text": "Tranquila. Hace las cuentas",
  "dur": 1.41
 },
 {
  "t": 15.2,
  "text": "cuando llega.",
  "dur": 0.57
 },
 {
  "t": 16.07,
  "text": "Espera, déjame pensarlo.",
  "dur": 1.32
 },
 {
  "t": 17.73,
  "text": "Ojo: Chispa no es la mala.",
  "dur": 1.6
 },
 {
  "t": 21.07,
  "text": "Sin ella, tardarías media hora",
  "dur": 1.66
 },
 {
  "t": 22.53,
  "text": "en cruzar la calle.",
  "dur": 1.0
 },
 {
  "t": 23.93,
  "text": "El problema: Chispa decide primero.",
  "dur": 2.1
 },
 {
  "t": 26.27,
  "text": "Pausa llega tarde.",
  "dur": 0.96
 },
 {
  "t": 29.93,
  "text": "Y cuando llega, Chispa ya ha pagado.",
  "dur": 1.66
 },
 {
  "t": 32.93,
  "text": "Ofertas flash. Cuentas atrás. Quedan dos.",
  "dur": 2.6
 },
 {
  "t": 35.6,
  "text": "Todo está diseñado para hablar con Chispa",
  "dur": 2.04
 },
 {
  "t": 38.27,
  "text": "antes de que Pausa se entere.",
  "dur": 1.35
 },
 {
  "t": 42.27,
  "text": "Todos tenemos una Chispa y una Pausa.",
  "dur": 1.9
 },
 {
  "t": 44.93,
  "text": "Aquí enseñamos a Pausa a llegar a tiempo.",
  "dur": 1.84
 },
 {
  "t": 48.93,
  "text": "¿Quién manda en tu cabeza?",
  "dur": 1.04
 },
 {
  "t": 50.93,
  "text": "Comenta rojo o azul.",
  "dur": 1.21
 }
]